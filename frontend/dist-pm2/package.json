{
  "name": "frontend",
  "version": "3.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:build": "set NEXT_OUTPUT=standalone&& next build && electron-builder",
    "android:build": "next build && npx cap copy && npx cap sync",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axios": "^1.13.6",
    "chart.js": "^4.5.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "next": "^16.2.1",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "socket.io-client": "^4.8.3",
    "sweetalert2": "^11.26.21",
    "sweetalert2-react-content": "^5.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.posnetx.app",
    "productName": "PosNetX",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/win/icon.ico",
      "asar": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icons/win/icon.ico",
      "uninstallerIcon": "build/icons/win/icon.ico",
      "installerHeaderIcon": "build/icons/win/icon.ico",
      "shortcutName": "PosNetX"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.posnetx.com"
      }
    ],
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": "../node-ia32/node.exe",
        "to": "bin/node-ia32.exe"
      },
      {
        "from": "../node-x64/node.exe",
        "to": "bin/node-x64.exe"
      }
    ],
    "extraFiles": [
      {
        "from": ".next/standalone/server.js",
        "to": "server/server.js"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/.next",
        "to": "server/.next",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "server/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "server/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/dist",
        "to": "backend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/lib",
        "to": "backend/lib",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/config.json",
        "to": "config.json"
      }
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/node": "^4.2.4",
    "electron-updater": "^6.8.3",
    "lightningcss": "1.32.0"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
